<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="col_task_stage_ready" model="project.task.type">
        <field name="name">Ready</field>
        <field name="sequence">10</field>
        <field name="fold">False</field>
    </record>
    <record id="col_task_stage_in_progress" model="project.task.type">
        <field name="name">In Progress</field>
        <field name="sequence">20</field>
        <field name="fold">False</field>
    </record>
    <record id="col_task_stage_waiting" model="project.task.type">
        <field name="name">Waiting on Partner</field>
        <field name="sequence">30</field>
        <field name="fold">False</field>
    </record>
    <record id="col_task_stage_done" model="project.task.type">
        <field name="name">Done</field>
        <field name="sequence">40</field>
        <field name="fold">True</field>
    </record>
</odoo>
