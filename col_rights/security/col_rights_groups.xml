<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_col_rights" model="ir.module.category">
        <field name="name">Content Rights</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Rights User</field>
        <field name="category_id" ref="module_category_col_rights"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Rights Manager</field>
        <field name="category_id" ref="module_category_col_rights"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
