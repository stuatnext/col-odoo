<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show originating opportunity on the agreement form -->
    <record id="view_col_agreement_form_crm" model="ir.ui.view">
        <field name="name">col.agreement.form.crm</field>
        <field name="model">col.agreement</field>
        <field name="inherit_id" ref="col_rights.view_col_agreement_form"/>
        <field name="arch" type="xml">
            <field name="signed_date" position="after">
                <field name="crm_lead_id"/>
            </field>
        </field>
    </record>

    <!-- Smart button on the opportunity linking to its rights agreements -->
    <record id="view_crm_lead_form_rights" model="ir.ui.view">
        <field name="name">crm.lead.form.rights</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_agreements" type="object"
                        class="oe_stat_button" icon="fa-handshake-o">
                    <field name="agreement_count" widget="statinfo" string="Agreements"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
